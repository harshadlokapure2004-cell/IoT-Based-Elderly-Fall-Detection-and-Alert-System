# Server Configuration
PORT=5000
HOST=0.0.0.0
SECRET_KEY=dev-secret-key-change-in-production
DEVICE_API_TOKEN=esp32-secure-device-token-123

# Database Configuration
DATABASE_URL=sqlite:///fall_detection.db

# Fall Detection Algorithm Thresholds
FREEFALL_THRESHOLD_G=0.5
IMPACT_THRESHOLD_G=2.5
GYRO_THRESHOLD_DPS=150.0
INACTIVITY_TIMEOUT_SEC=10.0
CONFIRMATION_WINDOW_SEC=3.0
CANCELLATION_WINDOW_SEC=15.0

# SMTP Email Notification Provider (Optional - Simulated if empty)
SMTP_SERVER=smtp.example.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_SENDER=alerts@elderlycare.io

# Twilio SMS Notification Provider (Optional - Simulated if empty)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# Simulator Default Settings
SIMULATOR_AUTOSTART=true
SIMULATOR_SAMPLING_RATE_HZ=10
